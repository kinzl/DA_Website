<!DOCTYPE html>
<html lang="en">
<head class="container">
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - SecureVeloMobilWebsite</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="css/index.css"/>
</head>
<body class="container body-container">
<nav class="navbar navbar-expand-lg">

    <img class="logo" src="img/LogoWhite.png" alt="Logo"/>
    <div class="container d-flex justify-content-center">
        <div class="navbar-collapse collapse d-lg-flex justify-content-start">

        </div>
        <div class="navbar-collapse collapse d-lg-flex justify-content-center">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link " asp-area="" asp-page="/Index">Startseite</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " asp-area="" asp-page="/AboutUs">Über uns</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " asp-area="" asp-page="/Privacy">Datenschutz</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link " href="https://www.htl-grieskirchen.at/wp/">Unsere Schule</a>
                </li>
            </ul>
        </div>
        <div class="navbar-collapse collapse d-lg-flex justify-content-end">
            <a class="navbar-brand">
                <h5>Summe Eingespartes CO<sub>2</sub>: <b>@IndexModel.TotalCo2Saved.ToString("0.0") kg</b></h5>
            </a>
        </div>
        <form method="post" asp-page-handler="Logout">
            <button class="navbar">Ausloggen</button>
        </form>
    </div>
</nav>

<div class="container body-container">
    <main role="main" class="container body-container">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>