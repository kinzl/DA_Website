@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = "Shared/_Layout";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/html">
<head>
    <title>Velomobil</title>
    <link rel="stylesheet" href="css/Index.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.css"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

</head>
<body>

<div class="container mt-3">
    <div class="row">
        <div class="left-section d-flex flex-column col-md-3">
            <!-- Listbox content goes here -->
            <form method="post" asp-page-handler="TimeFilterChanged">
                <select id="pastTime" onchange="this.form.submit()" name="selectedDay">
                    @for (int i = 0; i < @Model.FilterDates.Count(); i++)
                    {
                        @if (i == @Model.SelectedFilterDateIndex)
                        {
                            <option value="@Model.FilterDates[i].DayName" class="listGroupSelected" selected="selected">@Model.FilterDates[i].DayName</option>
                        }
                        else
                        {
                            <option value="@Model.FilterDates[i].DayName" class="listGroupSelected">@Model.FilterDates[i].DayName</option>
                        }
                    }
                </select>
            </form>
            <form method="post" asp-page-handler="SetStartDate">
                <label for="startDate">Start</label>
                <input id="startDate" type="date" onchange="this.form.submit()" name="startDate" value="@Model.SelectedFilterDate.startTime.ToString("yyyy-MM-dd")"/>
            </form>
            <form method="post" asp-page-handler="SetEndDate">
                <label for="endDate">End</label>
                <input id="endDate" type="date" onchange="this.form.submit()" name="endDate" value="@Model.SelectedFilterDate.endTime.ToString("yyyy-MM-dd")"/>
            </form>
            <form method="post" asp-page-handler="CourseChanged">
                <select id="routeList" size="10" onchange="this.form.submit()" name="courseId" class="routeListbox">
                    @for (int i = 0; i < @Model.Courses.Count; i++)
                    {
                        @if (i == @Model.SelectedCourseIndex)
                        {
                            <option value="@Model.Courses[i].CourseId" class="listGroupSelected" selected="selected">@Model.Courses[i].Name</option>
                        }
                        else
                        {
                            <option value="@Model.Courses[i].CourseId" class="listGroupSelected">@Model.Courses[i].Name</option>
                        }
                    }
                </select>
            </form>
            <label id="totalDistance"></label>
            <label id="maxSpeed">0 km/h (speed)</label>
            <label id="drivenTime">--:-- (time)</label>
            <label id="drivenDay">@Model.SelectedCourse.DayOfRecording.ToString("ddd dd-MM-yyyy hh:mm")</label>

        </div>
        <div class="center-section col-md-6">
            <!-- Map content goes here -->
            <div id="map"></div>
        </div>
        <div class="right-section  col-md-3">
            <!-- Stats content goes here -->

        </div>
    </div>
</div>
<script>
$(document).ready(function() {
    const map = L.map('map').setView([51.5074, -0.1278], 13); // Set the initial center coordinates and zoom level

    // Add the OpenStreetMap tile layer
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: 'Map data &copy; <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors',
      maxZoom: 19
    }).addTo(map);

    // Array of coordinates for the route you drove
    const routeCoordinates = @Html.Raw(Json.Serialize(Model.DetailPositions));
    const routeCoordinatesOnly = [];
    
    for (let item of routeCoordinates)
    {
        let positions = {posY:item["posY"], posX:item["posX"]};
        routeCoordinatesOnly.push(Object.values(positions));
    }
    
    // Add the route using a polyline
    const route = L.polyline(routeCoordinatesOnly, { color: 'blue' }).addTo(map)

    // Calculate the distance of the route
    let distance = 0;
    for (let i = 0; i < routeCoordinatesOnly.length - 1; i++) {
      let from = L.latLng(routeCoordinatesOnly[i]);
      let to = L.latLng(routeCoordinatesOnly[i + 1]);
      distance += from.distanceTo(to);
    }
    // console.log('Total distance: ' + distance + ' meters');

    const lblDistnace = $('#totalDistance');
    lblDistnace.html(distance + " Meters");

    // Add a marker to the map
    const lastTimeStamp = @Html.Raw(Json.Serialize(Model.LastDetailPosition));
    console.log(lastTimeStamp)
    const markerCoordinates = [lastTimeStamp["posY"], lastTimeStamp["posX"]]; // Example coordinates
    const marker = L.marker(markerCoordinates).addTo(map);

    // Fit the map bounds to the route and marker
    const bounds = L.latLngBounds(routeCoordinatesOnly.concat(markerCoordinates));
    map.fitBounds(bounds);
});

</script>
</body>
</html>