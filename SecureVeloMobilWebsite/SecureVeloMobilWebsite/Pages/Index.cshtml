@page
@using System.Globalization
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    Layout = "Shared/_Layout";
}

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/html">
<head>
    <title>Velomobil</title>
    <link rel="stylesheet" href="css/index.css"/>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.css"/>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="js/draw.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="container index-container body-container">
    <div class="row">
        <div class="left-section d-flex flex-column col-md-3">
            <div class="container-row">
                <form method="post" asp-page-handler="TimeFilterChanged">
                    <select id="pastTime" onchange="this.form.submit()" name="selectedDay" class="routeListbox">
                        @for (int i = 0; i < @Model.FilterDates.Count(); i++)
                        {
                            @if (i == @Model.SelectedFilterDateIndex)
                            {
                                <option value="@Model.FilterDates[i].DayName" class="listGroupSelected" selected="selected">@Model.FilterDates[i].DayName</option>
                            }
                            else
                            {
                                <option value="@Model.FilterDates[i].DayName" class="listGroupSelected">@Model.FilterDates[i].DayName</option>
                            }
                        }
                    </select>
                </form>
                <form method="post" asp-page-handler="SetDate" class="container-row stats">
                    <td>
                        <input id="startDate" type="date" onfocusout="this.form.submit()" name="startDate" value="@Model.SelectedFilterDate.StartTime.ToString("yyyy-MM-dd")" class="date"/>
                    </td>
                    <td>
                        <input id="endDate" type="date" onfocusout="this.form.submit()" name="endDate" value="@Model.SelectedFilterDate.EndTime.ToString("yyyy-MM-dd")" class="date"/>
                    </td>
                </form>
            </div>

            <div class="container-row">
                <form method="post" asp-page-handler="CourseChanged">
                    <select id="routeList" size="20" onchange="this.form.submit()" name="courseId" class="routeListbox">
                        @for (int i = 0; i < @Model.Courses.Count; i++)
                        {
                            @if (i == @Model.SelectedCourseIndex)
                            {
                                <option value="@Model.Courses[i].CourseId" class="listGroupSelected" selected="selected">@Model.Courses[i].Name</option>
                            }
                            else
                            {
                                <option value="@Model.Courses[i].CourseId" class="listGroupSelected">@Model.Courses[i].Name</option>
                            }
                        }
                    </select>
                </form>
                <div class="stats">
                    <table>
                        <tr>
                            <td>Strecke</td>
                            <td id="totalDistance">@Model.SelectedCourse.Distance.ToString("0.0") km</td>
                        </tr>
                        <tr>
                            <td>Max. Geschwindigkeit</td>
                            <td id="maxSpeed">@Model.SelectedCourse.DetailPosition?.Max(x => x.CurrentSpeed).ToString("0.0") kmh</td>
                        </tr>
                        <tr>
                            <td>Gefahrene Zeit</td>
                            <td id="drivenTime">@Model.DrivenTime.ToString(@"hh\:mm\:ss") h</td>
                        </tr>
                        <tr>
                            <td>Gefahrener Tag</td>
                            <td id="drivenDay">@Model.SelectedCourse.StartTime.ToString("ddd dd.MM.yyyy", CultureInfo.GetCultureInfo("de"))</td>
                        </tr>
                        <tr>
                            <td>Eingespartes CO<sub>2</sub></td>
                            <td>@Model.SelectedCourse.SavedCo2.ToString("0.0") kg</td>
                        </tr>
                    </table>
                </div>
            </div>

            <h6 style="color: red">@Model.InfoBoxText</h6>
            <canvas id="altitudeChart" class="altitudeChart"></canvas>
        </div>
        <div class="right-section col-md-6">
            <div id="map"></div>
        </div>

    </div>
</div>
<script>
$(document).ready(function () {
let data = @Html.Raw(Json.Serialize(Model.SelectedCourse.DetailPosition));
drawMap(data);
drawAltitudeDiagram(data);
})

</script>
</body>
</html>